{
  "name": "contact",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "npm run migrate:local && wrangler dev",
    "start": "npm run migrate:local && wrangler dev",
    "migrate:local": "wrangler d1 migrations apply contact --local",
    "migrate:remote": "wrangler d1 migrations apply contact --remote",
    "test": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "vitest": "~5.0.3",
    "wrangler": "^4.152.0"
  }
}